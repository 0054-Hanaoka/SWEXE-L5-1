<%= link_to "新規追加", new_tweet_path %><br>
<%= link_to "ログイン", top_main_path %><br>
<%= link_to "ログアウト", top_logout_path %><br>
<br>
ログイン中UID：<%= session[:login_uid] %>

<% if session[:login_uid] %>
  <p>こんにちは、<%= @user.uid %> さん！</p>
  <% if @profile.present? %>
    <%= link_to "プロフィール(過去の投稿)を見る", user_profile_path(@user) %>
  <% else %>
    <%= link_to "過去ツイート編集", edit_user_profile_path(@user) %>
  <% end %>

  <hr>
<% end %>

<h2>ツイート一覧</h2>
<% @tweets.each do |tweet| %>
  <div>
    <p>投稿者: <%= tweet.user&.uid || "不明" %></p>

    <p>内容: <%= tweet.message %></p>
    <p>いいね数: <%= tweet.likes.count %></p>

    <!-- いいね追加 -->
    <%= button_to "いいね", likes_path(tweet_id: tweet.id), method: :post %>
    
    <!-- いいね削除 -->
    <%= button_to "いいね削除", like_path(tweet.id), method: :delete, data: { confirm: "本当に解除しますか？" } %>

  </div>
<% end %>
