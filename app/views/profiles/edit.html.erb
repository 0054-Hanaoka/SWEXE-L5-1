<h2>過去のツイート</h2>

<% @user.tweets.each do |tweet| %>
  <div style="margin-bottom: 1em;">
    <p>
      <strong>内容:</strong> <%= tweet.message %><br>
        いいね数: <%= tweet.likes.count %>
    </p>
    <%= link_to "編集", edit_tweet_path(tweet) %>
    <%= link_to '削除', tweet_path(tweet), data: { turbo_method: :delete } %>
  </div>
<% end %>

<%= link_to "トップ画面", tweet_path %>