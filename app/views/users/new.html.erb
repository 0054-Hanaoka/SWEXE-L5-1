<%= form_with model: @user, local: true do |f| %>
  <%= f.label :uid, 'UID' %>
  <%= f.text_field :uid %>

  <%= f.label :password, 'PASS' %>
  <%= f.password_field :password %>

  <%= f.label :password_confirmation, 'PASS 確認' %>
  <%= f.password_field :password_confirmation %>

  <%= f.submit '作成' %>
<% end %>

<%= link_to "トップ画面", top_main_path %>
